# 仅作本地参考。正式部署在 GitHub Actions。
# 真实 key 和 SMTP 授权码放在 GitHub Settings -> Secrets and variables -> Actions。

# Secret：一个 Anyrouter key，两个池共用（多行时只取第一条非空行）
ANYROUTER_TOKENS="sk-ant-your-key"

# 可选：workflow 没有输入覆盖时使用这个地址
ANYROUTER_BASE_URL="https://anyrouter.top/v1"

# Variables（不要放 Secrets，否则日志会被打码）
# 模型选择器：留空 = Claude 用 opus[1m]、GPT 自动选最新；
# 写 "5.5" / "sonnet 5.5" 按语义匹配；写完整 id 或 opus[1m] 原样使用。
ANYROUTER_CLAUDE_MODEL=""
ANYROUTER_GPT_MODEL=""
# 保活间隔：留空 = 180-300 秒随机；0 = 可用即通知然后停；N 或 A-B 自定义
ANYROUTER_KEEPALIVE_SEC=""

# Secret（可选）：成功 / 配置错误邮件通知
QQ_EMAIL=""
QQ_SMTP_AUTH_CODE=""
