# Local reference only. GitHub Actions is the supported deployment target.
# Put the real key and SMTP credential in GitHub Settings -> Secrets and variables -> Actions.

# One Anyrouter key. The first non-empty line is used for both independent pools.
ANYROUTER_TOKENS="sk-ant-your-key"

# Optional local defaults; the workflow uses this URL when no input overrides it.
ANYROUTER_BASE_URL="https://anyrouter.top/v1"

# Optional GitHub Variables. Claude defaults to the verified CLI alias opus[1m]; GPT is discovered automatically.
ANYROUTER_CLAUDE_MODEL=""
ANYROUTER_GPT_MODEL=""

# Optional GitHub Secrets for success/configuration notifications.
QQ_EMAIL=""
QQ_SMTP_AUTH_CODE=""
